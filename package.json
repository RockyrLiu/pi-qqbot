{
  "name": "pi-qqbot",
  "version": "0.1.0",
  "type": "module",
  "description": "QQ 机器人作为 pi TUI 的移动端分身 — 通过 QQ 私聊/群聊远程与 pi 双向交互",
  "main": "index.ts",
  "license": "MIT",
  "homepage": "https://github.com/shenjiecode/pi-qqbot#readme",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "qq",
    "qqbot",
    "bot",
    "assistant",
    "agent"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "files": [
    "index.ts",
    "src",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.10.5",
    "typescript": "^5.9.3"
  }
}
